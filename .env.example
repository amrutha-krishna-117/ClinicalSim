# Choose one: groq, openai, anthropic, or fallback
AI_PROVIDER=groq

# Add a key for the provider selected above. Get keys from that provider's
# official developer console. Never commit your real key to Git.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Optional: replace the development secret before exposing the app publicly.
JWT_SECRET=dev-secret-clinicalsim-2024-change-in-prod

# Optional frontend API URL (Docker default is http://localhost:8000)
# NEXT_PUBLIC_API_URL=http://localhost:8000
